# MongoDB, Railway ou qualquer provedor compatível (Atlas, etc.)
MONGODB_URI=mongodb://user:password@host:27017/duomidea?authSource=admin
# Segredo para assinar sessões JWT (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque_por_um_segredo_aleatorio_com_no_minimo_32_chars
# URL pública da app (usado para cookies secure e CORS se necessário)
APP_URL=http://localhost:3000
NODE_ENV=development
# Usado APENAS pelo script de criação do primeiro admin, não é login em cada request
ADMIN_EMAIL=admin@duomidea.com
ADMIN_PASSWORD=SenhaForte123!
# Porta (Railway injeta PORT automaticamente)
PORT=3000
