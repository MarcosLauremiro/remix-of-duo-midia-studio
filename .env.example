# Modelo de variáveis. Copie para .env (desenvolvimento local). Nunca commite o .env.
# Valores abaixo são FICTÍCIOS. Em produção, configure como secrets no Cloudflare
# (painel ou `npx wrangler secret put NOME`), não em arquivos versionados.

# ── Banco (MongoDB) ───────────────────────────────────────────────────────────
# Usuário com privilégio mínimo (readWrite) apenas no banco da aplicação.
MONGODB_URI=mongodb://app_user:troque-esta-senha@exemplo.invalido:27017/?authSource=admin&tls=true
# Nome do banco da aplicação (não está na URI).
MONGODB_DB=duomidia_exemplo

# ── Sessão do painel admin ────────────────────────────────────────────────────
# Obrigatório, 32 caracteres ou mais. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele o login e as rotas admin falham de forma fechada (sem fallback).
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# ── Admin inicial (usado somente por `npm run admin:create`) ──────────────────
ADMIN_EMAIL=admin@exemplo.invalido
ADMIN_PASSWORD=troque-esta-senha-admin
# ADMIN_NAME=Admin
